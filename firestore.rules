rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function myDoc() {
      return /databases/$(database)/documents/allowedUsers/$(myEmail());
    }
    function isAllowed() {
      return signedIn() && exists(myDoc());
    }
    function isAdmin() {
      return isAllowed() && get(myDoc()).data.role == 'admin';
    }

    // Who may sign in. Only admins edit this list; everyone can read their own entry.
    match /allowedUsers/{email} {
      allow read: if signedIn() && (myEmail() == email || isAdmin());
      allow write: if isAdmin();
    }

    // Sales records: all team members read; reps create and edit their own; admins edit anything.
    match /records/{id} {
      allow read: if isAllowed();
      allow create: if isAllowed() && request.resource.data.submittedByEmail == myEmail();
      allow update: if isAdmin() ||
        (isAllowed() && resource.data.submittedByEmail == myEmail()
          && request.resource.data.submittedByEmail == myEmail());
      allow delete: if isAdmin() || (isAllowed() && resource.data.submittedByEmail == myEmail());
    }

    // Running serial number for records.
    match /counters/{doc} {
      allow read, write: if isAllowed();
    }

    // PIN hash. Only admins can change it.
    match /settings/{doc} {
      allow read: if isAllowed();
      allow write: if isAdmin();
    }
  }
}
